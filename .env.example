# SDR Engine — env vars
# Copy to .env and fill in. Never commit .env.
# See docs/ARCHITECTURE.md for full details on each var.

# ─── HubSpot ────────────────────────────────────────────────
# Private app token; scopes per docs/ARCHITECTURE.md Dependencies section
HUBSPOT_API_KEY=
# Daniel's HubSpot user ID — emails appear as sent on behalf of this owner
HUBSPOT_OWNER_ID=
# The Prospecting pipeline's ID (NOT closed-lost)
HUBSPOT_PROSPECTING_PIPELINE_ID=
# Property holding prospect type. RESOLVED 2026-05-14: funnel_type
# Multi-checkbox; values match labels in slug form
HUBSPOT_PROSPECT_TYPE_PROPERTY=funnel_type

# ─── Apollo (company URL/verification only, no enrichment) ──
APOLLO_API_KEY=

# ─── ZoomInfo (contact verification + qualified enrichment) ─
ZOOMINFO_API_KEY=
ZOOMINFO_TARGET_TITLES=CFO,Chief Financial Officer,Credit Manager,Director of Finance,VP Finance,Controller,VP Risk Management
MAX_ENRICHMENTS_PER_DAY=10
ENRICHMENT_CACHE_TTL_DAYS=90
# USA-only filter (compliance, see docs/COMPLIANCE.md TODO)
ZOOMINFO_COUNTRY_FILTER=United States

# ─── Microsoft Graph (SharePoint policy summaries) ──────────
# Per T2=A: SharePoint site + Sites.Selected scope (NOT Files.Read.All)
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_POLICY_FOLDER_ID=

# ─── Local LLM (via LiteLLM routing per A15) ────────────────
# LiteLLM endpoint — bound to 127.0.0.1 per A5
LLM_ENDPOINT=http://localhost:4000/v1/chat/completions
# Primary draft model (OpenClaw routes "local-main" → qwen3.5:27b)
LLM_MODEL_PRIMARY=local-main
# Fallback on 2nd validation failure (cloud, ~$0.05/call)
LLM_MODEL_FALLBACK=heavy-main
LLM_TIMEOUT_SECONDS=180
# Cost ceiling on cloud fallback (~$0.75/day at 15 × $0.05)
MAX_CLOUD_FALLBACK_PER_DAY=15

# ─── Prompt + Config Paths ──────────────────────────────────
PROMPT_FILE_PATH=prompts/draft-pipeline.txt
CTAS_FILE_PATH=prompts/ctas.json
TCIA_BROKERS_ROSTER=config/tcia-brokers.json
SECTOR_SIGNALS_PATH=config/sector-signals.json
HOLIDAY_FILE=config/holidays.json

# ─── Storage + UI ───────────────────────────────────────────
SQLITE_PATH=~/.sdr-engine/queue.db
# UI bound to 127.0.0.1 per A5; Cloudflare Tunnel reaches it locally
REVIEW_UI_PORT=5679
REVIEW_UI_HOST=127.0.0.1

# ─── Cadence + Rate (cron schedule + scheduler tuning) ──────
DAILY_SEND_CAP=3
WORKING_DAYS_PER_YEAR=250
RENEWAL_LEAD_DAYS=60
SKIP_RESURFACE_DAYS=30
DROPPED_COOLDOWN_DAYS=90
PHONE_TASK_LEAD_HOURS=36

# ─── Monitoring (OpenClaw) ──────────────────────────────────
# Sync webhook fires on LLM 5xx, HubSpot 4xx/5xx (A6)
OPENCLAW_WEBHOOK_URL=

# ─── Remote Access (Cloudflare Tunnel + Access) ─────────────
CLOUDFLARE_TUNNEL_HOSTNAME=sdr.tradecredit.agency
CLOUDFLARE_TUNNEL_UUID=
# Application audience tag (optional, used for JWT verification)
CLOUDFLARE_ACCESS_AUD_TAG=
